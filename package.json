{
  "name": "chat-xvc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.generated.jsonc",
    "dev:frontend": "vite --host 127.0.0.1",
    "build:frontend": "vite build",
    "deploy": "npm run build:frontend && wrangler deploy --config wrangler.generated.jsonc",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test:intent-router": "node scripts/test-intent-router.mjs",
    "test:prompt-service": "node scripts/test-prompt-service.mjs",
    "test:profile-intake-agent": "node scripts/test-profile-intake-agent.mjs",
    "test:profile-tools": "node scripts/test-profile-tools.mjs",
    "test:task-parser": "node scripts/test-task-parser.mjs",
    "test:file-intents": "node scripts/test-file-intents.mjs",
    "test:file-service": "node scripts/test-file-service.mjs",
    "test:document-processing": "node scripts/test-document-processing.mjs",
    "test:rag-service": "node scripts/test-rag-service.mjs",
    "test:memory-service": "node scripts/test-memory-service.mjs",
    "test:memory-route": "node scripts/test-memory-route.mjs",
    "test:serper-provider": "node scripts/test-serper-provider.mjs",
    "test:search-service": "node scripts/test-search-service.mjs",
    "test:search-failure-reply": "node scripts/test-search-failure-reply.mjs",
    "test:research-service": "node scripts/test-research-service.mjs",
    "test:ai-gateway-provider": "node scripts/test-ai-gateway-provider.mjs",
    "test:image-understanding-service": "node scripts/test-image-understanding-service.mjs",
    "test:audio-transcription-service": "node scripts/test-audio-transcription-service.mjs",
    "test:workers-ai-response": "node scripts/test-workers-ai-response.mjs",
    "test:feature:tasks": "node scripts/feature-task-management.mjs",
    "test:feature:files": "node scripts/feature-file-management.mjs",
    "test:feature:memory": "node scripts/feature-memory-management.mjs",
    "test:feature:research": "node scripts/feature-deep-research.mjs",
    "test:features": "npm run test:feature:tasks && npm run test:feature:files && npm run test:feature:memory && npm run test:feature:research",
    "eval:memory-retrieval": "node scripts/eval-memory-retrieval.mjs",
    "cf:provision": "node scripts/provision-cloudflare.mjs",
    "cf:sync-secrets": "node scripts/sync-secrets.mjs",
    "cf:migrate:local": "wrangler d1 migrations apply chat_xvc_db --local --config wrangler.generated.jsonc",
    "cf:migrate:remote": "wrangler d1 migrations apply chat_xvc_db --remote --config wrangler.generated.jsonc",
    "cf:deploy": "npm run build:frontend && wrangler deploy --config wrangler.generated.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.13",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@chatui/core": "^3.7.0",
    "fflate": "^0.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "unpdf": "^1.6.2"
  }
}
